{
  "buildCommand": "pnpm run build:client",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(?!api/).*",
      "destination": "/index.html"
    }
  ]
}
